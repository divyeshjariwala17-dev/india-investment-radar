# NEVER commit real secrets. Copy values only into local .env or Render private Environment Variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_PRIVATE_SECRET_KEY
SUPABASE_BUCKET=radar-private

# Google API mode (optional). Prefer GOOGLE_SERVICE_ACCOUNT_JSON as a private Render secret.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHARE_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_JSON={...PRIVATE SERVICE ACCOUNT JSON...}
